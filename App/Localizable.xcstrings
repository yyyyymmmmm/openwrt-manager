          "stringUnit": {
            "state": "translated",
            "value": "选择记住密码时，密码写入此设备解锁时可访问的钥匙串。你确认的证书指纹也保存在钥匙串中；这些条目使用 ThisDeviceOnly 保护，不通过 iCloud 钥匙串同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you choose to remember the password, it is written to a Keychain accessible when this device is unlocked. Certificate fingerprints you confirm are also stored in the Keychain; these items are protected with ThisDeviceOnly and do not sync through iCloud Keychain."
          }
        }
