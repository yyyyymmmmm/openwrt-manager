          "stringUnit": {
            "state": "translated",
            "value": "SSH 登录失败：用户名或密码不正确。请核对档案中保存的密码后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH sign-in failed: the username or password is incorrect. Check the password saved in the profile and try again."
          }
        }
      }
    },
    "SSH 连接失败。请检查网络与路由器状态后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接失败。请检查网络与路由器状态后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH connection failed. Check the network and the router, then try again."
          }
        }
      }
    },
    "SSH 连接超时。请确认手机与路由器在同一网络，并检查路由器上的 SSH 服务（dropbear）是否已开启。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接超时。请确认手机与路由器在同一网络，并检查路由器上的 SSH 服务（dropbear）是否已开启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH connection timed out. Make sure the phone and router are on the same network and that the router's SSH service (dropbear) is running."
          }
        }
      }
    },
