    "负载与内存需持续超阈才告警，避免瞬时尖峰打扰；离线与 WAN 需连续两次确认。触发与恢复成对通知，同类告警在冷却期内不重复。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载与内存需持续超阈才告警，避免瞬时尖峰打扰；离线与 WAN 需连续两次确认。触发与恢复成对通知，同类告警在冷却期内不重复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load and memory must stay above their thresholds before alerting, so brief spikes stay quiet; offline and WAN states need two consecutive confirmations. Firing and recovery arrive as a pair, and the same alert does not repeat during its cooldown."
          }
        }
      }
    },
    "负载均衡": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
