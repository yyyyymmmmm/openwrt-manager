          }
        }
      }
    },
    "安装与卸载走路由器自己的包管理通道（与电脑版软件包页相同），执行后回读列表验证；更新软件包在「在线升级」页逐个或全部进行。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装与卸载走路由器自己的包管理通道（与电脑版软件包页相同），执行后回读列表验证；更新软件包在「在线升级」页逐个或全部进行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs and removals go through the router's own package-manager channel (the same as the web UI's software page) and are verified by read-back; updates run per-package or in bulk on the Online Upgrade page."
          }
        }
      }
    },
    "安装软件包": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
