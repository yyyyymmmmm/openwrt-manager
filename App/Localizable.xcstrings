    "仅保留最近 50 条会话记录，不代表路由器完整日志。断开连接后清除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留最近 50 条会话记录，不代表路由器完整日志。断开连接后清除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the latest 50 session records are kept; this is not the router’s complete log. Cleared when you disconnect."
          }
        }
      }
    },
    "代理组与节点": {
      "extractionState": "manual",
