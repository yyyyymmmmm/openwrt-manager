    "%@\n%@\nSHA-256\n%@\n\n请通过可信方式核对指纹。信任后只对这个路由器地址生效。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%@\nSHA-256\n%@\n\n请通过可信方式核对指纹。信任后只对这个路由器地址生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%@\nSHA-256\n%@\n\nVerify the fingerprint through a trusted channel. Trust applies only to this router address."
          }
        }
      }
    },
    "%@ · 信道 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · channel %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 信道 %@"
          }
        }
      }
    },
    "%@ · 第 %lld 节": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · section %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 第 %lld 节"
          }
        }
      }
    },
    "%@ 出示的指纹与已信任记录不一致。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 出示的指纹与已信任记录不一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ presented a fingerprint that does not match the trusted record."
          }
        }
      }
    },
    "%@ 的应用请求已获路由器确认，等待连接验证。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的应用请求已获路由器确认，等待连接验证。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apply request for %@ was confirmed by the router; waiting for connection verification."
          }
        }
      }
    },
    "%@ 的应用请求未收到响应，请验证连接并核对配置。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的应用请求未收到响应，请验证连接并核对配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apply request for %@ received no response. Verify the connection and check the configuration."
          }
        }
      }
    },
    "%@ 的应用请求未收到确认，请验证连接后决定保留或回滚。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的应用请求未收到确认，请验证连接后决定保留或回滚。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apply request for %@ was not confirmed. Verify the connection, then decide to keep or roll back."
          }
        }
      }
    },
