      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此固件未向 App 会话开放 frpc 配置的读取（rpcd 未授权或配置不存在）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This firmware does not grant the app session read access to the frpc configuration (rpcd not authorized, or the configuration does not exist)."
