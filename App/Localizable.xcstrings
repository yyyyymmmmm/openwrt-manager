    "核心保护": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心保护"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core"
          }
        }
      }
    },
    "核心服务保护：「%@」是 App 与电脑管理页面的共同后端。停止或关闭自启会让你同时失去手机与电脑的管理通道，只能到路由器跟前恢复，因此这两项操作已禁用；启动与重启不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心服务保护：「%@」是 App 与电脑管理页面的共同后端。停止或关闭自启会让你同时失去手机与电脑的管理通道，只能到路由器跟前恢复，因此这两项操作已禁用；启动与重启不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core service protection: %@ is the shared backend of this app and the computer management pages. Stopping it or disabling its autostart would cut off both phone and computer management access, recoverable only at the router itself, so those two actions are disabled; starting and restarting are unaffected."
          }
        }
      }
    },
    "核心服务保护：「%@」是路由器的防火墙。停止或关闭自启会让防火墙规则失效、暴露内网，因此这两项操作已禁用；启动与重启不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心服务保护：「%@」是路由器的防火墙。停止或关闭自启会让防火墙规则失效、暴露内网，因此这两项操作已禁用；启动与重启不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core service protection: %@ is the router's firewall. Stopping it or disabling its autostart would void the firewall rules and expose the LAN, so those two actions are disabled; starting and restarting are unaffected."
          }
        }
      }
    },
    "核心服务保护：「%@」负责全网的域名解析与地址分配。停止或关闭自启会让设备无法上网、拿不到地址，因此这两项操作已禁用；启动与重启不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心服务保护：「%@」负责全网的域名解析与地址分配。停止或关闭自启会让设备无法上网、拿不到地址，因此这两项操作已禁用；启动与重启不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core service protection: %@ handles name resolution and address assignment for the whole LAN. Stopping it or disabling its autostart would leave devices without internet access or addresses, so those two actions are disabled; starting and restarting are unaffected."
          }
        }
      }
    },
    "核心服务保护：「%@」负责整台路由器的网络连接。停止或关闭自启会让全网断网且无法远程恢复，因此这两项操作已禁用；启动与重启不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心服务保护：「%@」负责整台路由器的网络连接。停止或关闭自启会让全网断网且无法远程恢复，因此这两项操作已禁用；启动与重启不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core service protection: %@ carries the router's entire network connectivity. Stopping it or disabling its autostart would take the whole network down with no remote recovery, so those two actions are disabled; starting and restarting are unaffected."
          }
        }
      }
    },
    "根文件系统": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根文件系统"
