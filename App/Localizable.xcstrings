          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a few addresses such as .1 / .254 and verifies each as OpenWrt; no whole-subnet sweep"
          }
        }
      }
    },
    "检查当前 Wi-Fi 所在网段的 80 / 443 端口；较大的网段仅检查手机所在的 /24 范围。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查当前 Wi-Fi 所在网段的 80 / 443 端口；较大的网段仅检查手机所在的 /24 范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks ports 80 / 443 on the current Wi-Fi subnet; on larger subnets only the /24 range containing your phone is checked."
