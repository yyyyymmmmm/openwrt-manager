            "state": "translated",
            "value": "路由器可能使用其他端口、只提供 IPv6，或没有广播服务。请确认 Wi-Fi，也可以手动输入管理网址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The router may use another port, offer IPv6 only, or not broadcast a service. Check the Wi-Fi, or enter the admin URL manually."
          }
        }
      }
    },
    "路由器名称": {
      "extractionState": "manual",
      "localizations": {
