    "点按档案即可切换连接；使用保存的密码前，会先以 Face ID 验证身份。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按档案即可切换连接；使用保存的密码前，会先以 Face ID 验证身份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a profile to switch to it. Your identity is verified with Face ID before a saved password is used."
          }
        }
      }
    },
    "切换到此路由器": {
      "extractionState": "manual",
      "localizations": {
